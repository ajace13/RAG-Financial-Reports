# Copy to .env and fill in. .env is gitignored.

# Elasticsearch
ES_URL=http://localhost:9200
ES_INDEX=finrag-chunks

# SEC requires a descriptive User-Agent with contact info, e.g. "Jane Doe jane.doe@example.com"
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=

# Where raw filings and processed chunks are written (relative paths resolve from the repo root)
DATA_DIR=data

# Retrieval models (Hugging Face ids). Defaults shown.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Generation. Set either key (or both: Claude is primary, OpenAI is the fallback).
# With neither, scripts/ask.py runs in retrieval-only mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (higher = more careful reasoning, more output tokens)
CLAUDE_EFFORT=high
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
