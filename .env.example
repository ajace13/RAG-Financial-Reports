# Copy to .env and fill in. .env is gitignored.

# Elasticsearch
ES_URL=http://localhost:9200
ES_INDEX=finrag-chunks

# SEC requires a descriptive User-Agent with contact info, e.g. "Jane Doe jane.doe@example.com"
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=

# Where raw filings and processed chunks are written (relative paths resolve from the repo root)
DATA_DIR=data

# Retrieval models (Hugging Face ids). Defaults shown.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# Device for question-time retrieval models: auto | cpu | cuda. Use cpu when a local LLM
# (Ollama) shares a small GPU: on an 8 GB card this freed ~2 GB of VRAM and made generation
# 2-4x faster, at the cost of ~5 s slower re-ranking. Bulk embedding still uses the GPU.
RETRIEVAL_DEVICE=auto

# Generation. Configure any of Claude / OpenAI / Ollama. With several, `auto` tries them in
# that order and falls through on errors. With none, scripts/ask.py is retrieval-only.

# Ollama (free, local; no account or key needed). Install from https://ollama.com/download,
# run `ollama pull qwen3:8b`, then set OLLAMA_MODEL. Check with scripts/check_llm.py.
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
# Context window per request. Ollama's own default (4k on <24 GB GPUs) truncates RAG prompts.
OLLAMA_NUM_CTX=8192
# Thinking mode for models that have one (qwen3 does). false (default) = fast answers;
# true = slower but better at arithmetic; default = whatever the model does by default.
OLLAMA_THINK=false
# Only for Ollama's hosted cloud models (OLLAMA_URL=https://ollama.com); not needed locally.
OLLAMA_API_KEY=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (higher = more careful reasoning, more output tokens)
CLAUDE_EFFORT=high
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
